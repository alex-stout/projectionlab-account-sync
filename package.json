{
	"dependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.7",
		"tailwindcss": "^4.3.1"
	},
	"description": "Browser extension to sync brokerage account balances into ProjectionLab",
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@playwright/test": "^1.60.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.1.8",
		"@wxt-dev/module-react": "^1.1.5",
		"addons-linter": "^10.6.0",
		"jsdom": "^29.1.1",
		"playwright": "^1.60.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8",
		"wxt": "^0.20.26"
	},
	"name": "projectionlab-account-sync",
	"private": true,
	"scripts": {
		"build": "wxt build",
		"build:e2e": "E2E=true wxt build",
		"build:firefox": "wxt build -b firefox --mv3",
		"check": "biome check",
		"check:fix": "biome check --write",
		"compile": "tsc --noEmit",
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox --mv3",
		"docs:screenshots": "npm run build:e2e && SCREENSHOTS=true playwright test screenshots",
		"e2e": "npm run build:e2e && playwright test",
		"e2e:ci": "CI=true npm run build:e2e && CI=true playwright test",
		"format": "biome format --write",
		"lint": "biome lint",
		"lint:firefox": "npm run build:firefox && addons-linter --self-hosted .output/firefox-mv3",
		"mock-sites": "vite e2e/mock-sites --port 3000",
		"postinstall": "wxt prepare && simple-git-hooks",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox --mv3"
	},
	"type": "module",
	"version": "0.9.0"
}
